datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id        String   @id @default(uuid())
  name      String
  price     Float
  unit      String
  category  String
  stock     Int
  image     String?
  altText   String?
  icon      String?
  sku       String   @unique
  supplier  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SaleTransaction {
  id             String   @id @default(uuid())
  orderId        String   @unique
  items          Json
  subtotal       Float
  tax            Float
  total          Float
  paymentMethod  String
  amountTendered Float
  changeDue      Float
  createdAt      DateTime @default(now())
}
