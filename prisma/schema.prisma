datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model Product {
  id        String   @id @default(uuid())
  name      String
  price     Float
  unit      String
  category  String
  stock     Int
  image     String?
  altText   String?
  icon      String?
  sku       String   @unique
  supplier  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String            @id @default(uuid())
  name         String
  username     String            @unique
  password     String
  pin          String
  role         String            // "manager" or "cashier"
  transactions SaleTransaction[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model SaleTransaction {
  id             String   @id @default(uuid())
  orderId        String   @unique
  items          Json
  subtotal       Float
  tax            Float
  total          Float
  paymentMethod  String
  amountTendered Float
  changeDue      Float
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  cashierName    String?
  createdAt      DateTime @default(now())
}

model SystemSetting {
  id                    String   @id @default("default")
  taxRate               Float    @default(8.5)
  spendingLimitEnabled  Boolean  @default(false)
  spendingLimit         Float    @default(5000.0)
  spendingDiscountType  String   @default("percentage") // "percentage" or "fixed"
  spendingDiscountValue Float    @default(5.0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SpendingDiscountRule {
  id            String   @id @default(uuid())
  minSubtotal   Float    @unique // spending threshold
  discountType  String   // "percentage" or "fixed"
  discountValue Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
